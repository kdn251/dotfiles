Host boole
    # HostName 72.60.165.172
    # Boole is a magic DNS name from Tailscale
    HostName boole
    SendEnv TERM
    User knaught
    IdentityFile ~/.ssh/id_ed25519
    RequestTTY force
    RemoteCommand cd ~/projects/ferryman && LANG=en_US.UTF-8 LC_CTYPE=en_US.UTF-8 LC_ALL=en_US.UTF-8 herdr
    # RequestTTY yes
    LogLevel QUIET
    LocalForward 3000 localhost:3000
    LocalForward 3001 localhost:3001
    LocalForward 4001 localhost:4001
    LocalForward 4174 localhost:4174
    LocalForward 3002 localhost:3002
    LocalForward 5173 localhost:5173
    LocalForward 5174 localhost:5174
    LocalForward 5175 localhost:5175
    LocalForward 8080 localhost:8080
    LocalForward 8385 localhost:8384 # Forward syncthing port to local
    # Shouldn't need these local forwards now that I'm using the magic DNS name above from Tailscale
    # LocalForward 3000 localhost:3000
    # LocalForward 5173 localhost:5173
    # LocalForward 8080 localhost:8080
    # LocalForward 8385 localhost:8384 # Forward syncthing port to local

Host claude
    HostName boole
    SendEnv TERM
    User knaught
    IdentityFile ~/.ssh/id_ed25519
    # run `claude --channels plugin:telegram@claude-plugins-official --dangerously-skip-permissions`
    # inside the tmux session to restart claude for chatting via telegram
    RemoteCommand tmux attach -t claude  tmux new-session -s claude
    RequestTTY yes
    LogLevel QUIET
