#!/usr/bin/env python3
"""Wake kevin-jr-pc via Turing, wait for Apollo, then open Moonlight."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import time

CONFIG_DIR = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'play-on-pc'
CONFIG = json.loads((CONFIG_DIR / 'connection.json').read_text())
PC = CONFIG['pc_address']
WAKE_SCRIPT = f"""
import socket, time
packet = bytes.fromhex('ff' * 6 + {CONFIG['pc_mac'].replace(':', '')!r} * 16)
with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    sock.bind(({CONFIG['relay_lan_address']!r}, 0))
    for _ in range(3):
        sock.sendto(packet, ({CONFIG['broadcast_address']!r}, 9))
        time.sleep(0.2)
print('Turing sent three wake packets to the gaming PC.')
"""

def notify(message, error=False):
    print(message, flush=True)
    subprocess.run(['notify-send', '-a', 'Play on PC', '-u',
                    'critical' if error else 'normal', 'Play on PC', message],
                   check=False)

def ready():
    try:
        with socket.create_connection((PC, CONFIG['apollo_port']), timeout=2):
            return True
    except OSError:
        return False

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true', help='Check Apollo without waking or launching')
    parser.add_argument('--no-launch', action='store_true', help='Wake and wait without opening Moonlight')
    args = parser.parse_args()
    if args.check:
        online = ready()
        print('Apollo is reachable.' if online else 'Apollo is not reachable.')
        return 0 if online else 1
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', str(Path.home() / '.cache')))
    runtime.mkdir(parents=True, exist_ok=True)
    with (runtime / 'play-on-pc.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            notify('Already waiting for your gaming PC.')
            return 0
        if not ready():
            notify('Asking Turing to wake your gaming PC…')
            try:
                result = subprocess.run([
                    'ssh', '-T', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=8',
                    '-o', 'StrictHostKeyChecking=yes', '-o', 'ClearAllForwardings=yes',
                    '-o', f"HostName={CONFIG['relay_address']}",
                    '-l', CONFIG['relay_user'], CONFIG['relay_host_alias'], 'python3 -'],
                    input=WAKE_SCRIPT, text=True, capture_output=True, timeout=20)
            except (OSError, subprocess.TimeoutExpired) as exc:
                notify(f'Could not reach Turing: {exc}', True)
                return 1
            if result.returncode:
                print(result.stderr, file=sys.stderr)
                notify('Could not send the wake packet. Check Tailscale and SSH access to Turing.', True)
                return 1
            print(result.stdout.strip(), flush=True)
            notify('Wake packet sent. Waiting up to 3 minutes for Apollo…')
            deadline = time.monotonic() + 180
            while not ready():
                if time.monotonic() >= deadline:
                    notify('The PC did not become ready. Check its power, Wake-on-LAN settings, Tailscale, and Apollo.', True)
                    return 1
                time.sleep(3)
        notify('Your gaming PC is ready.' if args.no_launch else 'Your gaming PC is ready. Opening Moonlight…')
        if not args.no_launch:
            subprocess.Popen(['moonlight'], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0

if __name__ == '__main__':
    sys.exit(main())
