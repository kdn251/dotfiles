# Enter: play videos in mpv, everything else via xdg-open
cmd open ${{
    case $(file --mime-type -Lb "$f") in
        video/*|audio/*)
            setsid -f mpv --vo=gpu --gpu-api=opengl "$f" >/dev/null 2>&1 ;;
        *)
            setsid -f xdg-open "$f" >/dev/null 2>&1 ;;
    esac
}}

map <enter> open
