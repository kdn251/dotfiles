#!/bin/bash
# Mount the homelab share (sshfs, fstab entry) only while the homelab is reachable.
# Run by homelab-media-mount.timer. Replaces x-systemd.automount, which blocked
# Thunar / GTK file choosers for seconds-to-minutes whenever the host was down.
#
# The mountpoint deliberately lives OUTSIDE $HOME. GLib auto-lists mounts that
# sit under the home directory in the GTK sidebar ("Devices"), and builds that
# list by stat()ing each mountpoint on the file manager's main thread. A wedged
# sshfs makes that stat hang, so Thunar would not even map its window until the
# ssh connection timed out. Anything under /mnt is ignored by that code path.
# ~/homelab-media stays as a symlink so every existing path keeps working; a
# symlink is only ever lstat()ed by the sidebar, which never touches the mount.
HOST=100.74.35.69
PORT=22
MP=/mnt/homelab-media
LINK=/home/knaught/homelab-media
UNIT='mnt-homelab\x2dmedia.mount'

reachable() { timeout 2 bash -c "exec 3<>/dev/tcp/$HOST/$PORT" 2>/dev/null; }
# Use mountinfo rather than mountpoint(1)/stat — those can block on a dead sshfs.
mounted()   { awk -v mp="$MP" '$5 == mp {f=1} END {exit !f}' /proc/self/mountinfo; }

mkdir -p "$MP"

# Keep the compatibility symlink in place (survives a fresh install / stow run).
# -h avoids following it into the mount, which would block while sshfs is wedged.
if [ ! -h "$LINK" ] && [ ! -e "$LINK" ]; then
    ln -s "$MP" "$LINK"
    chown -h knaught:knaught "$LINK"
fi

if mounted; then
    if ! reachable; then
        echo "host $HOST unreachable, lazily unmounting $MP"
        umount -l "$MP" || true
        systemctl reset-failed "$UNIT" 2>/dev/null || true
    fi
else
    if reachable; then
        echo "host $HOST reachable, mounting $MP"
        systemctl start "$UNIT"
    fi
fi
