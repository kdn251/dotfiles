# Kanshi configuration for Hyprland laptop docking
# Save this file as ~/.config/kanshi/config

# Profile for when external monitor is connected (docked)
# Replace "External-Monitor-Name" with your actual external monitor name
# Replace "eDP-1" with your actual laptop screen name if different
# profile docked1 {
#     output "DP-6" enable
#     output "eDP-1" disable
# }

# Match the LG by EDID description rather than the DP-N port name —
# amdgpu enumerates DisplayPort connectors differently than Intel's i915/xe,
# so the port number is not stable across kernels/reboots on this Ryzen box.
# AMD has no DSC handshake bug, so 4K@144 should work here if you want it.
profile framework_docked {
    output "LG Electronics LG ULTRAGEAR+ *" enable mode 3840x2160@60Hz position 0,0 scale 1.5
    output "eDP-1" disable
    exec ~/.config/kanshi/docked-setup.sh
}

# Profile for when only laptop screen is available (undocked)
profile framework_undocked {
    # output "eDP-1" enable
    # output "eDP-1" enable mode 2880x1920@120.00000Hz position 0,0 scale 2.0
    # output "eDP-1" {
    #     enable
    #     position 0,0
    #     scale 1.5
    # }
    # CRITERIA: Matches the unique description of the Framework's panel.
    output "BOE NE135A1M-NY1 Unknown" {
        enable
        # Use the specific mode found in the hyprctl output
        # mode 2880x1920@120.00Hz
        # Use lower refresh rate to increase battery life
        mode 2880x1920@60.00Hz
        position 0,0
        scale 2.0
    }
    exec ~/.config/kanshi/undocked-setup.sh
}


# Profile for ThinkPad when external monitor is connected (Docked)
profile thinkpad_docked {
    # Requires both DP-2 and eDP-1 to be connected for this profile to be considered
    output "DP-2" enable mode 1920x1080@120.00Hz position 0,0 scale 1.0
    output "eDP-1" disable
    exec ~/.config/kanshi/docked-setup.sh
}

# Profile for ThinkPad when only laptop screen is available (Undocked)
profile thinkpad_undocked {
    # Only requires eDP-1 to be connected for this profile to be considered
    output "AU Optronics 0x103D Unknown" {
        enable
        # Use the specific mode we found to ensure maximum reliability
        mode 1920x1080@60.01Hz
        position 0,0
        scale 1.5
    }
    exec ~/.config/kanshi/undocked-setup.sh
}

# Profile for knuth (Framework 13 Pro) when external monitor is connected (Docked).
# 4K@60 (not 144) because the Intel xe driver on Panther Lake silently fails the
# DSC handshake required for 4K@144 over USB-C — panel goes black at 144Hz.
profile knuth_docked {
    output "LG Electronics LG ULTRAGEAR+ *" enable mode 3840x2160@60Hz position 0,0 scale 1.5
    output "eDP-1" disable
    exec ~/.config/kanshi/docked-setup.sh
}

# Profile for knuth when only laptop screen is available (Undocked)
profile knuth_undocked {
    output "eDP-1" {
        enable
        # 120Hz for smooth cursor; drop to 60Hz to save battery
        mode 2880x1920@120.00Hz
        position 0,0
        scale 2.0
    }
    exec ~/.config/kanshi/undocked-setup.sh
}

# Fallback for knuth when the external monitor's EDID doesn't make it through
# the TS4's DP chip: the monitor then identifies as the Synaptics MST hub with
# a garbage serial and only standard VESA fallback modes (max 1920x1080), so
# the description-matched profiles above never fire. Match the fallback
# identity and drive it at the best mode it offers. If the monitor is a
# higher-res panel showing up blurry, replug it (or use another dock port) to
# get a real EDID — then knuth_docked takes over.
profile knuth_docked_noedid {
    # --custom: without EDID the monitor only advertises up to 1920x1080, but
    # the panel is 4K and the link handles 3840x2160@60 fine (verified 2026-08-17).
    output "Synaptics Inc Non-PnP 0x01010101" enable mode --custom 3840x2160@60Hz position 0,0 scale 1.5
    output "eDP-1" disable
    exec ~/.config/kanshi/docked-setup.sh
}
