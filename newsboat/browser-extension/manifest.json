{
  "manifest_version": 3,
  "name": "Newsboat Reading Position",
  "version": "1.0.1",
  "description": "Remember reading progress for articles opened from Newsboat Starred. Stored locally.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "reading.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
