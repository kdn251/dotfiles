urls-source "miniflux"
# Pulling in this file to get credentials for connecting to miniflux
include "~/.newsboat/miniflux_creds.conf"

# Uncomment to start newsboat on tags page
# these 3 lines create a loop so newsboat opens to the tags page 
# and "q" returns you back to tags page (instead of default home page)
# run-on-startup select-tag
# bind-key q select-tag feedlist
# bind-key q quit tagselection

miniflux-show-special-feeds no

# Compact metadata columns leave more space for names and titles.
feedlist-title-format " 🚢 Newsboat"
feedlist-format " %3i  %n %S  %4v %-6k  %t"
articlelist-format " %f  %D  %-9p %?T?%-18T │ ?%t"
datetime-format "%b %d %H:%M"
text-width 90
# Keep list headers focused on the view name (History, Starred, Downloaded, etc.).
articlelist-title-format " %T"
searchresult-title-format " %N %V - Search results for '%s' (%u unread, %t total)%?F? matching filter '%F'&?"
# feedlist-format "%?T?║%4i %n %8u (%T) %t &╠═════════════════════════════════════════════════════%t?"

browser "~/scripts/newsboat-brave-app.sh %u"
# refresh-on-startup yes

# Download video (,d)
# macro d set browser "~/scripts/download-video.sh %u &" ; open-in-browser ; set browser "~/scripts/mpv-yt %u"
macro d set browser "~/scripts/newsboat-download-video.sh %u &" ; open-in-browser ; set browser "~/scripts/newsboat-brave-app.sh %u" ; toggle-article-read "read" -- "Start download, mark read, and advance"
macro c set browser "python3 ~/scripts/newsboat-download.py --cancel-url %u" ; open-in-browser ; set browser "~/scripts/newsboat-brave-app.sh %u" -- "Cancel selected video download"

# Delete downloaded video (,D)
macro D set browser "~/scripts/delete-downloaded.sh %u" ; open-in-browser-noninteractively ; set browser "~/scripts/newsboat-brave-app.sh %u" ; reload-urls -- "Delete selected download"

# Cancel in progress download
macro S set browser "~/scripts/cancel-download.sh %u" ; open-in-browser ; set browser "~/scripts/newsboat-brave-app.sh %u" -- "Cancel legacy video download"

# Open Twitch stream by username in MPV
# to watch streamer that's currently live 
# when RSS feed hasn't updated or RSS feed 
# for that user hasn't been added
macro w set browser "~/scripts/twitch-launcher.sh" ; open-in-browser ; set browser "~/scripts/newsboat-brave-app.sh %u" -- "Open Twitch live-channel picker"

# Refresh downloaded videos feed (,R)
macro R set browser "~/scripts/update-downloaded-query.sh" ; open-in-browser ; set browser "~/scripts/newsboat-brave-app.sh %u" ; reload-urls -- "Rebuild and reload Downloads view"

# Keep Newsboat interactive while playback loads; mark read when launched.
# Stream YouTube video
# macro v set browser "setsid -f mpv-yt %u" ; open-in-browser ; set browser "google-chrome-stable %u"
macro v set browser "~/scripts/newsboat-play-video.sh %u" ; open-in-browser-noninteractively ; set browser "~/scripts/newsboat-brave-app.sh %u" ; toggle-article-read "read" -- "Launch video in background; mark read"
macro a set browser "python3 ~/scripts/newsboat-archive.py %u" ; open-in-browser-noninteractively ; set browser "~/scripts/newsboat-brave-app.sh %u" ; toggle-article-read "read" -- "Open latest archived article; mark read"

# macro r set browser "w3m %u" ; open-in-browser ; set browser "google-chrome-stable %u"
macro r set browser "w3m -o display_image=1 %u" ; open-in-browser ; toggle-article-read ; set browser "~/scripts/newsboat-brave-app.sh %u" -- "Read in w3m; toggle read status"

# Bookmark article (,b)
macro b set browser "~/scripts/bookmark-article.sh %u '%T'" ; open-in-browser ; set browser "~/scripts/newsboat-brave-app.sh %u" -- "Bookmark article"

# Unbookmark article (,B) - removes from list
macro B set browser "~/scripts/unbookmark-article.sh %u '%T'" ; open-in-browser ; set browser "~/scripts/newsboat-brave-app.sh %u" -- "Remove article bookmark"

reload-threads 100
# Pick up Miniflux updates automatically while this session is open.
auto-reload yes
reload-time 15

# --- cache retention -------------------------------------------------------
# Without these the cache only ever grows: it had reached 75,557 articles
# (135MB, oldest from 2017) and cost 5.3s just to open, because cleanup-on-quit
# defaults to "nudge", which only warns and never actually prunes.
#
# Miniflux is the source of truth, so nothing here is lost -- this only bounds
# the LOCAL cache. 90 days and 250 per feed, whichever bites first.
cleanup-on-quit yes
keep-articles-days 90
max-items 250

show-read-articles no
show-read-feeds yes
# Start with the main views, including when they are empty.
run-on-startup set-filter "feedtitle = \"📬 New\" or feedtitle = \"⭐ Starred\" or feedtitle = \"📥 Downloads\" or feedtitle = \"📣 Commentary\" or feedtitle = \" Favorites\" or feedtitle = \"🌎 All\""

# Ask before closing from the main feed list; q still goes back inside feeds.
confirm-exit yes

# Keybinds
# Native help includes standard keys and descriptions of every custom macro.
bind ? everywhere help -- "Show shortcuts (q to return)"
# The session wrapper handles this request independently of the selected feed.
bind H everywhere set browser "newsboat-history://show" ; set browser "~/scripts/newsboat-brave-app.sh %u" -- "History: recent browser links and videos (q to return)"
bind S articlelist,searchresultslist undo-checkpoint unstar ; set browser "python3 ~/scripts/newsboat-starred.py remove %u" ; open-in-browser-noninteractively ; set browser "~/scripts/newsboat-brave-app.sh %u" ; down -- "Unstar item and advance"
bind S article undo-checkpoint unstar ; set browser "python3 ~/scripts/newsboat-starred.py remove %u" ; open-in-browser-noninteractively ; set browser "~/scripts/newsboat-brave-app.sh %u" -- "Unstar item"
bind s articlelist,article,searchresultslist undo-checkpoint star ; set browser "python3 ~/scripts/newsboat-starred.py save %u" ; open-in-browser-noninteractively ; set browser "~/scripts/newsboat-brave-app.sh %u" ; toggle-article-read "read" "group" -- "Star item, mark read, and advance"
bind U everywhere undo-action -- "Undo recent read, star, Commentary, or Favorites changes (repeat U)"
bind n articlelist,article,searchresultslist toggle-article-read -- "Toggle read/unread (same as N)"
bind-key j down
bind-key k up
bind-key g home
bind-key G end
# bind-key L pagedown
# bind-key h pagedown

# Always restore Brave before opening a link, even after a media macro.
# Keep Newsboat visible; o and O play YouTube/Twitch and open other links in Brave.
bind o everywhere set browser "python3 ~/scripts/newsboat-open.py %u" ; open-in-browser-noninteractively ; set browser "~/scripts/newsboat-brave-app.sh %u" ; toggle-article-read "read" -- "Play YouTube/Twitch in mpv; otherwise Brave; mark read"
bind O everywhere set browser "python3 ~/scripts/newsboat-open.py %u" ; open-in-browser-noninteractively ; set browser "~/scripts/newsboat-brave-app.sh %u" ; toggle-article-read "read" -- "Play YouTube/Twitch in mpv; otherwise Brave; mark read"
# Pick up automatically rebuilt Downloaded queries when refreshing feeds.
bind R feedlist,articlelist,searchresultslist reload-all -- "Refresh all feeds from any list"

# Colors - clean and minimal
color listfocus          black   cyan    bold
color listfocus_unread   black   cyan    bold
color listnormal         default default
color listnormal_unread  default default bold
color info               black   cyan    bold
color article            default default

# Color status glyphs without changing the surrounding text or column widths.
# Style the adjacent cell too so Kitty sizes stars equally on read/unread rows.
highlight articlelist ".*📌.*" cyan default bold
highlight articlelist "󰓎 " yellow default bold
highlight articlelist "" red default bold
highlight feedlist "" red default bold

# Show query feeds
prepopulate-query-feeds yes

# Filter queries for high-quality content
# Filter out ads/paid content
ignore-article "*" "title =~ \"Sponsored\""
ignore-article "*" "title =~ \"#Sponsored\""
ignore-article "*" "title =~ \"sponsored\""
ignore-article "*" "title =~ \"#sponsored\""
ignore-article "*" "title =~ \"^Ad:\""
ignore-article "*" "title =~ \"^#Ad:\""
ignore-article "*" "title =~ \"^ad:\""
ignore-article "*" "title =~ \"^#ad:\""

# Try multiple patterns to catch different LIVE formats
# for some reason articles with LIVE for Twitch don't seem
# "streamable" i.e. when I hit my hotkey ",v" to watch the
# livestream or VOD it errors/never loads
ignore-article "*" "title =~ \"LIVE\\s*$\""
ignore-article "*" "title =~ \"\\sLIVE$\""
ignore-article "*" "title =~ \"\\|\\s*LIVE$\""
ignore-article "*" "title =~ \"-\\s*LIVE$\""
ignore-article "*" "tags =~ \"LIVE\""

# highlight feedlist "---.*---" cyan default bold
# highlight feedlist ".*0/0.." default default invis

user-agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# Collect items for commentary independently of Starred.
bind c articlelist,article,searchresultslist undo-checkpoint commentary ; set browser "python3 ~/scripts/newsboat-commentary.py save %u" ; open-in-browser-noninteractively ; set browser "~/scripts/newsboat-brave-app.sh %u" -- "Save to Commentary"
bind C articlelist,article,searchresultslist undo-checkpoint commentary ; set browser "python3 ~/scripts/newsboat-commentary.py remove %u" ; open-in-browser-noninteractively ; set browser "~/scripts/newsboat-brave-app.sh %u" -- "Remove from Commentary"

# Per-item notes: return from the editor to update the paper badge.
bind I articlelist,article,searchresultslist set browser "python3 ~/scripts/newsboat-notes.py %u" ; open-in-browser ; set browser "~/scripts/newsboat-brave-app.sh %u" -- "Edit notes for this item"

# Long-term favorites, independent of Starred and Commentary.
bind f articlelist,article,searchresultslist undo-checkpoint favorites ; set browser "python3 ~/scripts/newsboat-favorites.py save %u" ; open-in-browser-noninteractively ; set browser "~/scripts/newsboat-brave-app.sh %u" -- "Save to Favorites"
bind F articlelist,article,searchresultslist undo-checkpoint favorites ; set browser "python3 ~/scripts/newsboat-favorites.py remove %u" ; open-in-browser-noninteractively ; set browser "~/scripts/newsboat-brave-app.sh %u" -- "Remove from Favorites"
