+std::string ItemListFormAction::thumbnail_request()
+{
+    if (f.get("showthumbnail") != "1" || list.get_position() >= visible_items.size()) { return ""; }
+    return f.get("thumbnail:x") + ";" + f.get("thumbnail:y") + ";" +
+        f.get("thumbnail:w") + ";" + f.get("thumbnail:h") + ";" +
+        visible_items[list.get_position()].first->link();
+}
+
 void ItemListFormAction::prepare()
 {
+    if (std::getenv("NEWSBOAT_THUMBNAILS")) {
+        struct winsize size {};
+        ioctl(STDOUT_FILENO, TIOCGWINSZ, &size);
+        set_value("showthumbnail", size.ws_col >= 100 && size.ws_row >= 16 ? "1" : "0");
+        recalculate_widget_dimensions();
+    }
 	set_keymap_hints();
 
 	std::lock_guard<std::mutex> mtx(redraw_mtx);
