+// An external worker publishes download status; rendering never runs commands.
+static std::map<std::string, std::string> download_status;
+static std::string download_revision()
+{
+    const char* path = std::getenv("NEWSBOAT_DOWNLOAD_STATUS");
+    struct stat info {};
+    if (!path || stat(path, &info) != 0) { return ""; }
+    const auto version = std::to_string(info.st_mtim.tv_sec) + ":" +
+        std::to_string(info.st_mtim.tv_nsec) + ":" + std::to_string(info.st_size);
+    static std::string loaded;
+    if (loaded != version) {
+        std::ifstream input(path);
+        std::map<std::string, std::string> updated;
+        std::string line;
+        while (std::getline(input, line)) {
+            const auto split = line.find('\t');
+            if (split != std::string::npos) {
+                updated[line.substr(0, split)] = line.substr(split + 1);
+            }
+        }
+        download_status = std::move(updated);
+        loaded = version;
+    }
+    return version;
+}
