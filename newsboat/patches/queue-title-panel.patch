+
+void FormAction::update_queue_header()
+{
+    if (!base_title_set) { base_title = head_line.get_text(); base_title_set = true; }
+    const auto path = std::getenv("NEWSBOAT_QUEUE_HEADER");
+    std::string title, creator, progress;
+    if (path) {
+        std::ifstream input(path);
+        std::getline(input, title, '\t');
+        std::getline(input, creator, '\t');
+        std::getline(input, progress);
+    }
+    const auto width = utils::to_u(f.get("title:w"));
+    const auto heart = utils::to_u(f.get("favorite-heart:w"));
+    const auto available = width > heart ? width - heart : 0;
+    if (title.empty() || available < 60) { head_line.set_text(base_title); return; }
+    const auto budget = available - std::min(24u, available / 3) - 2;
+    const auto suffix = " " + progress;
+    const auto suffix_width = utils::strwidth(suffix);
+    std::string right;
+    if (budget > suffix_width + 12) {
+        auto room = budget - suffix_width - 3;
+        auto author = utils::substr_with_width(creator, std::min<size_t>(20, room / 3));
+        auto name = utils::substr_with_width(title, room - utils::strwidth(author));
+        right = name + " · " + author + suffix;
+    } else { right = utils::substr_with_width(progress, budget); }
+    auto left = utils::substr_with_width(base_title, available - utils::strwidth(right) - 2);
+    head_line.set_text(left + std::string(available - utils::strwidth(left) - utils::strwidth(right) - 1, ' ') + right + " ");
 }
 
