+#ifndef NEWSBOAT_RECENT_LIBRARY_H
+#define NEWSBOAT_RECENT_LIBRARY_H
+#include <cstdlib>
+#include <ctime>
+#include <fstream>
+#include <map>
+#include <string>
+namespace newsboat { namespace recent_library {
+inline int kind(const std::string& title, const std::string& url) {
+    if (title == "⭐ Starred" || url.find("query:⭐ Starred:") == 0) { return 1; }
+    if (title == "📥 Downloads" || url.find("query:📥 Downloads:") == 0) { return 2; }
+    return 0;
+}
+inline bool recent(int type, const std::string& url) {
+    const char* base = std::getenv(type == 1 ? "NEWSBOAT_STARRED_STATUS" : "NEWSBOAT_DOWNLOAD_STATUS");
+    if (!base) { return true; }
+    const auto now = std::time(nullptr);
+    struct Snapshot { std::time_t checked = 0; bool available = false; std::map<std::string,double> dates; std::map<std::string,bool> active; };
+    static std::map<std::string,Snapshot> snapshots;
+    auto& snapshot = snapshots[base];
+    if (snapshot.checked != now) {
+        snapshot.checked = now; snapshot.dates.clear(); snapshot.active.clear();
+        std::ifstream input(std::string(base) + ".saved");
+        snapshot.available = input.good();
+        std::string line;
+        while (std::getline(input,line)) {
+            const auto tab = line.find('\t');
+            if (tab != std::string::npos) {
+                snapshot.dates[line.substr(0,tab)] = std::strtod(line.c_str()+tab+1,nullptr);
+            }
+        }
+        if (type == 2) {
+            std::ifstream statuses(base);
+            while (std::getline(statuses,line)) {
+                const auto tab=line.find('\t');
+                if (tab != std::string::npos) {
+                    const auto status=line.substr(tab+1);
+                    if (status == "…" || status.find("↓") == 0) { snapshot.active[line.substr(0,tab)] = true; }
+                }
+            }
+        }
+    }
+    if (!snapshot.available || snapshot.active.count(url)) { return true; }
+    const auto found=snapshot.dates.find(url);
+    return found != snapshot.dates.end() && found->second >= now - 14*24*60*60;
+}
+inline unsigned int star_count(unsigned int fallback) {
+    const char* base=std::getenv("NEWSBOAT_STARRED_STATUS");
+    if (!base) { return fallback; }
+    std::ifstream input(base);
+    if (!input.good()) { return fallback; }
+    unsigned int count=0; std::string url;
+    while (std::getline(input,url)) { if (recent(1,url)) { ++count; } }
+    return count;
+}
+}}
+#endif
