+std::string ItemListFormAction::title_hover_request()
+{
+    const auto offset = list.get_scroll_offset();
+    const auto x = utils::to_u(f.get("items:x"));
+    const auto y = utils::to_u(f.get("items:y"));
+    std::string result;
+    for (std::uint32_t row = 0; row < list.get_height() && offset + row < visible_items.size(); ++row) {
+        auto item = visible_items[offset + row];
+        if (feed->title() == "⭐ Starred" || feed->title() == "🎮 Playthroughs" ||
+            feed->title() == "Playlists · 🎮 Playthroughs") { item.second = offset + row; }
+        const auto format = item_row_format(offset + row);
+        const auto field = format.find("%t");
+        if (field == std::string::npos) { continue; }
+        const auto width = list.get_width();
+        const auto available = row >= 1 && row <= thumbnail_height ? width - std::min(38u, width) : width;
+        const auto prefix = item2formatted_line(item, available, format.substr(0, field), cfg->get_configvalue("datetime-format")).plaintext();
+        const auto left = utils::strwidth(prefix) + 3; // Creator avatar and spacer.
+        auto title = item.first->title();
+        for (auto& c : title) { if (static_cast<unsigned char>(c) < 32 || c == 127) { c = ' '; } }
+        if (left >= available || utils::strwidth(title) <= available - left) { continue; }
+        result += std::to_string(x + left) + ";" + std::to_string(y + row) + ";" +
+            std::to_string(x + available) + ";" + title + "\n";
+    }
+    return result;
+}
