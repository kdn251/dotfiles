+std::string FeedListFormAction::title_hover_request()
+{
+    const auto format = cfg->get_configvalue("feedlist-format");
+    const auto field = format.find("%t");
+    if (field == std::string::npos) { return ""; }
+    const auto offset = list.get_scroll_offset();
+    const auto x = utils::to_u(f.get("feeds:x"));
+    const auto y = utils::to_u(f.get("feeds:y"));
+    std::string result;
+    for (std::uint32_t row = 0; row < list.get_height() && offset + row < visible_feeds.size(); ++row) {
+        const auto entry = visible_feeds[offset + row];
+        const auto prefix = format_line(format.substr(0, field), entry.first, entry.second, list.get_width()).plaintext();
+        const auto left = utils::strwidth(prefix) + (entry.first->is_query_feed() ? 0 : 3);
+        auto title = entry.first->title();
+        for (auto& c : title) { if (static_cast<unsigned char>(c) < 32 || c == 127) { c = ' '; } }
+        if (left >= list.get_width() || utils::strwidth(title) <= list.get_width() - left) { continue; }
+        result += std::to_string(x + left) + ";" + std::to_string(y + row) + ";" +
+            std::to_string(x + list.get_width()) + ";" + title + "\n";
+    }
+    return result;
 }
 
