+static std::string snooze_path()
+{
+    if (const char* queue = std::getenv("NEWSBOAT_QUEUE_STATUS")) {
+        return std::string(queue) + ".snooze";
+    }
+    const char* state = std::getenv("XDG_STATE_HOME");
+    const char* home = std::getenv("HOME");
+    return (state ? std::string(state) : std::string(home ? home : "/tmp") + "/.local/state") + "/newsboat/viewing-queue.tsv.snooze";
+}
