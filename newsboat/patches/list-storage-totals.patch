+static std::string library_storage_size(const std::string& title, const std::string& url)
+{
+    const std::string kind = title == "📥 Downloads" || url.find("query:📥 Downloads:") == 0 ? "downloads" :
+        title == "Playlists · 🎮 Playthroughs" || title == "🎮 Playthroughs" ? "playthroughs" : "";
+    if (!kind.empty()) {
+        if (const char* stars = std::getenv("NEWSBOAT_STARRED_STATUS")) {
+            std::ifstream sizes(std::string(stars) + ".storage");
+            std::string line;
+            while (std::getline(sizes, line)) {
+                if (line.find(kind + "\t") == 0) { return "  ·  " + line.substr(kind.size() + 1); }
+            }
+        }
+    }
+    return "";
+}
