+std::string FeedListFormAction::row_avatar_request()
+{
+    const auto format = cfg->get_configvalue("feedlist-format");
+    const auto title_field = format.find("%t");
+    if (title_field == std::string::npos) { return ""; }
+    const auto offset = list.get_scroll_offset();
+    const auto x = utils::to_u(f.get("feeds:x"));
+    const auto y = utils::to_u(f.get("feeds:y"));
+    std::string result;
+    for (std::uint32_t row = 0; row < list.get_height() && offset + row < visible_feeds.size(); ++row) {
+        const auto entry = visible_feeds[offset + row];
+        if (entry.first->is_query_feed()) { continue; }
+        const auto source = entry.first->rssurl();
+        const auto url = source.find_first_not_of("0123456789") == std::string::npos ?
+            "newsboat-feed://" + source : source;
+        if (url.find_first_of("\n\r\t") != std::string::npos) { continue; }
+        auto title = entry.first->title();
+        for (auto& character : title) {
+            if (character == '\n' || character == '\r' || character == '\t') { character = ' '; }
+        }
+        const auto prefix = format_line(format.substr(0, title_field), entry.first, entry.second, list.get_width()).plaintext();
+        result += std::to_string(x + utils::strwidth(prefix)) + ";" + std::to_string(y + row) + ";" + url + "\t" + title + "\t" + source + "\n";
+    }
+    return result;
+}
