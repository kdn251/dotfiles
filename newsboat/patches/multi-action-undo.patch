+namespace {
+std::vector<View::UndoState> read_undo_history(const char* path)
+{
+    std::vector<View::UndoState> states;
+    std::ifstream input(path);
+    View::UndoState state;
+    while (input >> std::quoted(state.token) >> std::quoted(state.guid)
+        >> std::quoted(state.url) >> state.unread >> state.deleted
+        >> state.has_star >> state.star >> state.target_star
+        >> state.has_commentary >> state.commentary) {
+        states.push_back(state);
+    }
+    return states;
+}
+
+void write_undo_history(const char* path, const std::vector<View::UndoState>& states)
+{
+    if (states.empty()) { std::remove(path); return; }
+    const auto temporary = std::string(path) + "." + std::to_string(getpid());
+    std::ofstream output(temporary);
+    for (const auto& state : states) {
+        output << std::quoted(state.token) << ' ' << std::quoted(state.guid) << ' '
+            << std::quoted(state.url) << ' ' << state.unread << ' ' << state.deleted << ' '
+            << state.has_star << ' ' << state.star << ' ' << state.target_star << ' '
+            << state.has_commentary << ' ' << state.commentary << '\n';
+    }
+    output.close(); std::rename(temporary.c_str(), path);
+}
+}
 
