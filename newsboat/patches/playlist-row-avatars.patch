+    const auto x = utils::to_u(f.get("items:x"));
+    const auto y = utils::to_u(f.get("items:y"));
+    std::string result;
+    for (std::uint32_t row = 0; row < list.get_height() && offset + row < visible_items.size(); ++row) {
+        const auto url = visible_items[offset + row].first->link();
+        if (url.find("newsboat-playthroughs://") != 0) { continue; }
+        result += std::to_string(x) + ";" + std::to_string(y + row) + ";" + url + "\n";
+    }
+    return result;
