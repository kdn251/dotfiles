+namespace {
+std::string home_key(const std::shared_ptr<RssFeed>& feed)
+{
+    const auto url = feed->rssurl();
+    if (url.find("query:") != 0) { return ""; }
+    auto name = url.substr(6, url.find(':', 6) - 6);
+    // Home names are stable across changes to their leading emoji or query.
+    const auto space = name.find_last_of(' ');
+    return space == std::string::npos ? name : name.substr(space + 1);
+}
+std::string home_order_path()
+{
+    if (const auto override = std::getenv("NEWSBOAT_HOME_ORDER")) { return override; }
+    if (const auto state = std::getenv("XDG_STATE_HOME")) {
+        if (*state) { return std::string(state) + "/newsboat/home-order"; }
+    }
+    const auto home = std::getenv("HOME");
+    return std::string(home ? home : ".") + "/.local/state/newsboat/home-order";
+}
+}
+
+bool FeedListFormAction::is_home() const
+{
+    return !all_sources && !std::getenv("NEWSBOAT_HOME_NESTED") &&
+        !visible_feeds.empty() && std::all_of(visible_feeds.begin(), visible_feeds.end(),
+            [](const auto& row) { return row.first->is_query_feed(); });
+}
+
+bool FeedListFormAction::move_home_row(const std::string& action)
+{
+    if (!is_home()) { return false; }
+    const auto target = home_key(visible_feeds.at(list.get_position()).first);
+    if (action == "yank") {
+        home_yank = target;
+        v.get_statusline().show_message("Home row picked up — p: move below, P: move above");
+        return true;
+    }
+    if (home_yank.empty()) {
+        v.get_statusline().show_error("Pick up a Home row with yy first"); return true;
+    }
+    if (home_yank == target) { return true; }
+    auto order = home_order;
+    order.erase(std::remove(order.begin(), order.end(), home_yank), order.end());
+    auto destination = std::find(order.begin(), order.end(), target);
+    if (destination == order.end()) { return true; }
+    if (action == "after") { ++destination; }
+    order.insert(destination, home_yank);
+    const auto path = home_order_path();
+    try {
+        std::filesystem::create_directories(std::filesystem::path(path).parent_path());
+        const auto temporary = path + ".tmp";
+        std::ofstream output(temporary);
+        for (const auto& key : order) { output << key << "\n"; }
+        output.close();
+        if (!output) { throw std::runtime_error("write failed"); }
+        std::filesystem::rename(temporary, path);
+    } catch (const std::exception&) {
+        v.get_statusline().show_error("Could not save homepage order"); return true;
+    }
+    home_order = order;
+    v.get_ctrl().update_feedlist();
+    for (unsigned int i = 0; i < visible_feeds.size(); ++i) {
+        if (home_key(visible_feeds[i].first) == home_yank) { list.set_position(i); break; }
+    }
+    do_redraw = true;
+    v.get_statusline().show_message("Homepage order saved");
+    return true;
+}
