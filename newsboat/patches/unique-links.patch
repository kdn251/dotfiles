+void Controller::sync_duplicate_read(const std::string& url, bool read)
+{
+    if (url.empty()) { return; }
+    std::vector<std::shared_ptr<RssItem>> matches;
+    for (const auto& feed : feedcontainer.get_all_feeds()) {
+        if (feed->is_query_feed()) { continue; }
+        std::lock_guard<std::mutex> lock(feed->item_mutex);
+        for (const auto& item : feed->items()) {
+            if (item->link() == url) { matches.push_back(item); }
+        }
+    }
+    // set_unread notifies the source feed; release its mutex before doing so.
+    for (const auto& item : matches) {
+        if (item->unread() == read) { item->set_unread(!read); }
+    }
+    update_feedlist();
+}
