+static std::set<std::string> pending_actions;
+static std::set<std::pair<std::string, std::string>> pending_removals;
+static unsigned int action_frame = 0;
+static std::string pending_action_revision()
+{
+    pending_actions.clear();
+    pending_removals.clear();
+    if (const char* stars = std::getenv("NEWSBOAT_STARRED_STATUS")) {
+        const auto directory = std::filesystem::path(stars).parent_path() / "actions-pending";
+        std::error_code error;
+        for (std::filesystem::directory_iterator it(directory, error), end; !error && it != end; it.increment(error)) {
+            if (it->path().extension() != ".txt") { continue; }
+            std::ifstream input(it->path());
+            std::string url, owner;
+            if (std::getline(input, url) && std::getline(input, owner) && !url.empty()) {
+                struct stat info {};
+                if (stat(owner.c_str(), &info) == 0) {
+                    pending_actions.insert(url);
+                    std::string kind;
+                    if (std::getline(input, kind) && !kind.empty()) { pending_removals.insert({url, kind}); }
+                }
+            }
+        }
+    }
+    const auto ticks = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    action_frame = (ticks / 100) % 10;
+    std::string revision;
+    for (const auto& url : pending_actions) { revision += url + "\n"; }
+    for (const auto& removal : pending_removals) { revision += removal.first + "\t" + removal.second + "\n"; }
+    if (!revision.empty()) { revision += std::to_string(action_frame); }
+    return revision;
+}
