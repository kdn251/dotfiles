+void View::remember_action(std::shared_ptr<RssItem> item, std::shared_ptr<RssFeed> feed,
+    std::optional<bool> target_star)
+{
+    UndoState state;
+    state.token = std::to_string(getpid()) + ":" + std::to_string(
+        std::chrono::steady_clock::now().time_since_epoch().count());
+    state.guid = item->guid(); state.url = item->link();
+    state.unread = item->unread(); state.deleted = item->deleted();
+    state.item = item; state.feed = feed;
+    for (size_t i = 0; i < feed->items().size(); ++i) {
+        if (feed->items()[i]->guid() == state.guid) { state.index = i; break; }
+    }
+    if (target_star) {
+        state.has_star = true; state.target_star = *target_star;
+        if (const char* path = std::getenv("NEWSBOAT_STARRED_STATUS")) {
+            // Once the queue drains, the display index is authoritative again.
+            const std::string filename(path);
+            const auto queue = filename.substr(0, filename.find_last_of('/')) + "/star-actions";
+            bool pending = false;
+            if (auto* directory = opendir(queue.c_str())) {
+                while (auto* entry = readdir(directory)) {
+                    const std::string name(entry->d_name);
+                    if (name.size() > 5 && name.substr(name.size()-5) == ".json") { pending = true; break; }
+                }
+                closedir(directory);
+            }
+            if (!pending) { star_intents.clear(); }
+            std::ifstream input(path); std::string url;
+            while (std::getline(input, url)) { if (url == state.url) { state.star = true; break; } }
+        }
+        // A queued request can precede the display index. Use its desired state.
+        if (star_intents.count(state.url)) { state.star = star_intents.at(state.url); }
+        star_intents[state.url] = *target_star;
+    }
+    last_action = state;
+    if (const char* path = std::getenv("NEWSBOAT_UNDO_FILE")) {
+        const auto temporary = std::string(path) + "." + std::to_string(getpid());
+        std::ofstream output(temporary);
+        output << std::quoted(state.token) << ' ' << std::quoted(state.guid) << ' '
+            << std::quoted(state.url) << ' ' << state.unread << ' ' << state.deleted << ' '
+            << state.has_star << ' ' << state.star << ' ' << state.target_star << '\n';
+        output.close(); std::rename(temporary.c_str(), path);
+    }
+}
+
+void View::sync_undoable_read(std::shared_ptr<RssItem> item, bool read)
+{
+    if (const char* helper = std::getenv("NEWSBOAT_UNDO_HELPER")) {
+        const auto browser = cfg->get_configvalue("browser");
+        cfg->set_configvalue("browser", "python3 " + utils::quote(helper) +
+            " restore %u keep " + (read ? "read" : "unread"));
+        const auto result = open_in_browser(item->link(), "", "", "", false);
+        cfg->set_configvalue("browser", browser);
+        if (!result || *result != 0) { status_line.show_error("Could not queue read-state change"); }
+    } else {
+        ctrl.mark_article_read(item->guid(), read);
+    }
+}
+
+void View::undo_action()
+{
+    auto saved = last_action;
+    const char* journal = std::getenv("NEWSBOAT_UNDO_FILE");
+    if (journal) {
+        UndoState shared;
+        std::ifstream input(journal);
+        if (!(input >> std::quoted(shared.token) >> std::quoted(shared.guid)
+                >> std::quoted(shared.url) >> shared.unread >> shared.deleted
+                >> shared.has_star >> shared.star >> shared.target_star)) {
+            status_line.show_message("Nothing to undo"); return;
+        }
+        if (!saved || saved->token != shared.token) { saved = shared; }
+    }
+    if (!saved) { status_line.show_message("Nothing to undo"); return; }
+    auto state = *saved;
+    // Enqueue compensation after pending star changes, never wait for HTTP here.
+    if (const char* helper = std::getenv("NEWSBOAT_UNDO_HELPER")) {
+        const auto browser = cfg->get_configvalue("browser");
+        cfg->set_configvalue("browser", "python3 " + utils::quote(helper) + " restore %u " +
+            (state.has_star ? (state.star ? "star" : "unstar") : "keep") +
+            (state.unread ? " unread" : " read"));
+        const auto result = open_in_browser(state.url, "", "", "", false);
+        cfg->set_configvalue("browser", browser);
+        if (!result || *result != 0) { status_line.show_error("Could not queue undo"); return; }
+    }
+    const auto restore_item = [&](std::shared_ptr<RssItem> item) {
+        item->set_unread(state.unread);
+        item->set_deleted(state.deleted);
+        rsscache->mark_item_deleted(item->guid(), state.deleted);
+    };
+    if (state.item) { restore_item(state.item); }
+    if (state.feed && state.item) {
+        auto& items = state.feed->items();
+        if (std::none_of(items.begin(), items.end(), [&](const auto& i) { return i->guid() == state.guid; })) {
+            state.feed->add_item(state.item);
+            std::rotate(items.begin() + std::min(state.index, items.size()-1), items.end()-1, items.end());
+        }
+    }
+    for (const auto& feed : ctrl.get_feedcontainer()->get_all_feeds()) {
+        for (const auto& item : feed->items()) {
+            if (item->guid() == state.guid) { restore_item(item); }
+        }
+    }
+    if (!std::getenv("NEWSBOAT_UNDO_HELPER")) { ctrl.mark_article_read(state.guid, !state.unread); }
+    for (const auto& form : formaction_stack) {
+        form->set_redraw(true);
+        if (const auto list = std::dynamic_pointer_cast<ItemListFormAction>(form)) {
+            list->select_undo_item(state.guid);
+        }
+    }
+    if (journal) { std::remove(journal); }
+    if (state.has_star) { star_intents[state.url] = state.star; }
+    last_action.reset();
+    status_line.show_message("Undid last read/star change");
+}
