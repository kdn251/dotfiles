+std::optional<bool> ItemListFormAction::run_visual_commands(
+    const std::vector<MacroCmd>& commands, BindingType type)
+{
+    if (!visual_active || commands.empty()) { return std::nullopt; }
+    bool deleting_downloads = false;
+    bool bulk = false, read_action = false, opens_browser = false;
+    for (const auto& cmd : commands) {
+        if (cmd.op == OP_UNDO_CHECKPOINT) { bulk = true; }
+        if (cmd.op == OP_TOGGLEITEMREAD) { read_action = true; }
+        if (cmd.op == OP_OPENINBROWSER || cmd.op == OP_OPENINBROWSER_NONINTERACTIVE) { opens_browser = true; }
+        if (cmd.op == OP_SET && cmd.args.size() == 2 && cmd.args[0] == "browser") {
+            const auto& browser = cmd.args[1];
+            if (browser.find("delete-downloaded.sh ") != std::string::npos) { bulk = true; deleting_downloads = true; }
+        }
+    }
+    bulk = bulk || (read_action && !opens_browser);
+    if (!bulk) {
+        const auto op = commands.front().op;
+        if (op == OP_VISUAL_ROWS || op == OP_VISUAL_CANCEL || op == OP_QUIT || op == OP_HARDQUIT || op == OP_MACROPREFIX ||
+            (op > OP_SK_MIN && op < OP_SK_MAX)) { return std::nullopt; }
+        // Opening/searching/refreshing still acts normally on the cursor item,
+        // never on every selected item. Do not retain a hidden selection.
+        cancel_visual();
+        return std::nullopt;
+    }
+    const auto range = visual_range();
+    std::vector<std::string> selected, neighbours;
+    std::set<std::string> urls;
+    for (unsigned int i = range.first; i <= range.second && i < visible_items.size(); ++i) {
+        if (urls.insert(visible_items[i].first->link()).second) {
+            selected.push_back(visible_items[i].first->guid());
+        }
+    }
+    for (size_t i = range.second + 1; i < visible_items.size(); ++i) {
+        neighbours.push_back(visible_items[i].first->guid());
+    }
+    for (size_t i = range.first; i > 0; --i) {
+        neighbours.push_back(visible_items[i - 1].first->guid());
+    }
+    const auto browser = cfg->get_configvalue("browser");
+    cancel_visual();
+    const auto select = [&](const std::string& guid) {
+        restore_selection_guid.reset();
+        for (size_t i = 0; i < visible_items.size(); ++i) {
+            if (visible_items[i].first->guid() == guid) {
+                list.set_position(i);
+                return true;
+            }
+        }
+        return false;
+    };
+    v.begin_undo_group();
+    size_t completed = 0;
+    bool success = true;
+    for (const auto& guid : selected) {
+        prepare();
+        if (!select(guid)) { continue; }
+        if (deleting_downloads) {
+            v.remember_action(visible_items[list.get_position()].first, feed, std::nullopt, 3);
+            setenv("NEWSBOAT_DOWNLOAD_UNDO_TOKEN", v.undo_history.back().token.c_str(), 1);
+        }
+        for (const auto& cmd : commands) {
+            // Single-item bindings advance the cursor; a bulk action must not.
+            if ((cmd.op > OP_SK_MIN && cmd.op < OP_SK_MAX) || cmd.op == OP_NEXTUNREAD) { continue; }
+            prepare();
+            const bool present = select(guid);
+            if (!present && cmd.op != OP_SET && cmd.op != OP_RELOADURLS && cmd.op != OP_PURGE_DELETED) { continue; }
+            if (!process_op(cmd.op, cmd.args, type)) { success = false; break; }
+        }
+        if (!success) { break; }
+        ++completed;
+    }
+    unsetenv("NEWSBOAT_DOWNLOAD_UNDO_TOKEN");
+    v.end_undo_group();
+    cfg->set_configvalue("browser", browser);
+    prepare();
+    bool positioned = false;
+    for (const auto& guid : neighbours) {
+        if (select(guid)) { positioned = true; break; }
+    }
+    if (!positioned && !selected.empty()) { select(selected.front()); }
+    store_selection();
+    invalidate_list();
+    if (success) {
+        v.get_statusline().show_message(strprintf::fmt("Applied action to %u selected rows", static_cast<unsigned int>(completed)));
+    }
+    return success;
+}
