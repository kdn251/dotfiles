+std::string FormAction::scroll_row_title(const std::string& title, const std::string& key,
+    unsigned int columns, bool selected) const
+{
+    if (!selected) { return title; }
+    const auto now = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    const auto identity = key + "\n" + title + "\n" + std::to_string(columns);
+    if (identity != scrolling_row_key) {
+        scrolling_row_key = identity;
+        scrolling_row_started = now;
+    }
+    row_title_scrolling = columns > 0 && utils::strwidth(title) > columns;
+    if (!row_title_scrolling) { return title; }
+    const auto distance = utils::strwidth(title) - columns;
+    const auto ticks = (now - scrolling_row_started) / 175;
+    const auto phase = static_cast<size_t>(ticks) % (distance + 7);
+    const auto offset = phase < 2 ? 0 : std::min(phase - 2, distance);
+    const auto wide = utils::str2wstr(title);
+    size_t index = 0, skipped = 0;
+    while (index < wide.size() && skipped < offset) {
+        skipped += std::max(0, ::wcwidth(wide[index++]));
+    }
+    return utils::wstr2str(wide.substr(index));
+}
+
