+    std::string icon;
+    if (const char* status = std::getenv("NEWSBOAT_DOWNLOAD_STATUS")) {
+        static std::map<std::string, std::string> platforms;
+        static std::string loaded;
+        const std::string path = std::string(status) + ".feeds";
+        struct stat info {};
+        if (stat(path.c_str(), &info) == 0) {
+            const auto version = path + std::to_string(info.st_mtim.tv_sec) + ":" + std::to_string(info.st_mtim.tv_nsec);
+            if (version != loaded) {
+                platforms.clear();
+                std::ifstream input(path);
+                std::string line;
+                while (std::getline(input, line)) {
+                    const auto split = line.find('\t');
+                    if (split != std::string::npos) { platforms[line.substr(0, split)] = line.substr(split + 1); }
+                }
+                loaded = version;
+            }
+            const auto found = platforms.find(feed->rssurl());
+            if (found != platforms.end()) { icon = found->second; }
+        }
+    }
+    if (icon.empty()) { icon = media_platform_icon(feed->link()); }
+    if (icon.empty()) { icon = media_platform_icon(feed->rssurl()); }
+    return icon + title;
