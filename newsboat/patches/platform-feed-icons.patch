 namespace newsboat {
 
+// Match platform hosts, not unrelated URLs that merely mention a video site.
+inline std::string media_platform_icon(const std::string& url)
+{
+    const auto start = url.find("://");
+    if (start == std::string::npos) { return ""; }
+    const auto host = url.substr(start + 3, url.find_first_of("/:?#", start + 3) - (start + 3));
+    if (host == "youtube.com" || host == "www.youtube.com" || host == "m.youtube.com" || host == "youtu.be") { return " "; }
+    if (host == "twitch.tv" || host == "www.twitch.tv" || host == "clips.twitch.tv" || host == "twitchrss.appspot.com") { return " "; }
+    return "";
+}
+
 enum class DlStatus { SUCCESS, TO_BE_DOWNLOADED, DURING_DOWNLOAD, DL_ERROR };
 
