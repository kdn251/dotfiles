{
  "margin-top": 5,
  "margin-left": 10,
  "margin-right": 10,
  "height": 15,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/miniflux_download",
    "custom/twitch_vod_download",
    "custom/yt-download",
    "custom/recording",
    "custom/handy",
    // "custom/blanket",
    "custom/protonvpn",
    // "custom/tailscale",
    // "custom/rclone",
    // "pulseaudio",
    // "temperature",
    "bluetooth",
    "network",
    "battery"
  ],
  "hyprland/window": {
    "format": "{}",
    "max-length": 35,
    "rewrite": {
      "": "knaught"
    },
    "separate-outputs": true
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    // Hand2 pointer on hover, so the workspace numbers read as clickable.
    "cursor": true,
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 4,
      "HDMI-A-1": 3
    }
  },
  "clock": {
    "format": "{:%A %I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "kitty --class calendar-float ~/scripts/waybar-calendar.sh"
  },
  "cpu": {
    "format": "  {usage}%",
    "tooltip": false
  },
  "memory": {
    "format": "MEM {usage}%"
  },
  // "temperature": {
  //   "critical-threshold": 80,
  //   "format": "{icon} {temperatureC}°C",
  //   "format-icons": ["", "", ""]
  // },
"bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "format-connected": "", 
    "format-connected-battery": "",
    "on-click": "bash -c 'bluetoothctl power on >/dev/null; sleep 0.3; kitty --class bluetui-float bluetui'",
    // These lines control the hover state (tooltip)
    "tooltip-format": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)"
},
  "battery": {
    // omarchy's battery presentation: a 10-step ramp with a separate charging
    // ramp, icon-only in the bar, and the detail moved into the tooltip.
    // Omitted from omarchy's version: on-click "omarchy-menu power" and
    // on-click-right "omarchy-battery-status" -- neither command exists here.
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-full": "󰂅",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-alt": "{time} {icon}",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5
  },
"network": {
    // Signal-strength ramp (empty outline -> filled cone), mapped across
    // signalStrength 0-100. Same Material Design glyphs omarchy uses.
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-wifi": "{icon}",
    // Signal strength only refreshes on poll, not on netlink events.
    "interval": 5,
    "format-ethernet": "󰈁",
    "format-disconnected": "OFFLINE",
    "on-click": "kitty --class networkmanager-float nmtui",
    "tooltip-format": "{ifname}: {ipaddr}",
    "tooltip-format-wifi": "SSID: {essid}\nStrength: {signalStrength}%" // Add this line
},
  "custom/handy": {
    "exec": "/home/knaught/scripts/handy-waybar.sh",
    "return-type": "json",
    "restart-interval": 1,
    "format": "{icon}",
    "format-icons": {
      "idle": "\uf130",
      "recording": "\uf111",
      "transcribing": "\uf110",
      "stopped": "\uf131"
    },
    "on-click": "handy --toggle-transcription",
    "tooltip": true
  },
  "custom/recording": {
    "format": "{}",
    "exec": "cat /tmp/recording.txt",
    "interval": 5,
    "hide-empty-text": true,
    "tooltip": true
  },
  "custom/blanket": {
    "format": "", // Or any icon you prefer
    "tooltip": true,
    "on-click": "blanket",
    "exec": "echo '{\"text\": \"Blanket\", \"tooltip\": \"Click to toggle controls\"}'",
    "return-type": "json"
  },
  "custom/protonvpn": {
    "format": "{}",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "exec": "~/scripts/protonvpn-waybar.sh",
    "on-click": "~/scripts/protonvpn-waybar.sh toggle",
    "tooltip": true
  },
  "custom/tailscale": {
    "format": "{}",
    "return-type": "json",
    "interval": 5,
    "exec": "~/scripts/tailscale-exit-node.sh",
    "on-click": "~/scripts/tailscale-exit-node.sh toggle",
    "tooltip": true
  },
  "custom/miniflux_download": {
    "format": "{}",
    "exec": "cat /tmp/miniflux_download_status.txt",
    "interval": 60,
    "hide-empty-text": true,
    "tooltip": true, // Explicitly enables tooltips
    "max-length": 30 // Optional: Keeps the bar tidy
  },
  "custom/twitch_vod_download": {
    "format": "{}",
    "exec": "cat /tmp/twitch_vod_status.txt",
    "interval": 5,
    "hide-empty-text": true,
    "tooltip": true
  },
  "custom/yt-download": {
    "exec": "~/scripts/waybar-yt-download.sh",
    "return-type": "json",
    "interval": 60,
    "tooltip": false
  },
  "custom/rclone": {
    "format": "{}",
    "return-type": "json",
    "interval": 60,
    "exec": "~/.config/waybar/scripts/rclone_status.sh",
    "on-click": "notify-send 'Rclone Stats' \"$(rclone rc core/stats --rc-no-auth | jq -r '.transferring[] | .name' | head -n 5)\""
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  }
}
