{
  "margin-top": 5,
  "margin-left": 10,
  "margin-right": 10,
  "height": 15,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/miniflux_download",
    "custom/twitch_dl",
    // Superseded by custom/twitch_dl, which shows the same state as an
    // animated icon with a clickable panel. Uncomment to get the plain
    // text readout back.
    // "custom/twitch_vod_download",
    "custom/yt-download",
    "custom/recording",
    "custom/handy",
    // "custom/blanket",
    "custom/protonvpn",
    // "custom/tailscale",
    // "custom/rclone",
    // "pulseaudio",
    // "temperature",
    "custom/display",
    // Speaker icon: click opens pavucontrol (was Alt+Shift+V).
    "pulseaudio",
    "bluetooth",
    "network",
    "battery"
  ],
  "hyprland/window": {
    "format": "{}",
    "max-length": 35,
    "rewrite": {
      "": "knaught"
    },
    "separate-outputs": true
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    // Hand2 pointer on hover, so the workspace numbers read as clickable.
    "cursor": true,
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 4,
      "HDMI-A-1": 3
    }
  },
  "clock": {
    "format": "{:%A %I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "kitty --class calendar-float ~/scripts/waybar-calendar.sh"
  },
  "cpu": {
    "format": "  {usage}%",
    "tooltip": false
  },
  "memory": {
    "format": "MEM {usage}%"
  },
  // "temperature": {
  //   "critical-threshold": 80,
  //   "format": "{icon} {temperatureC}°C",
  //   "format-icons": ["", "", ""]
  // },
"bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "format-connected": "", 
    "format-connected-battery": "",
    // Click opens a device panel (swaync notification with action buttons):
    // quick connect/disconnect for paired devices, plus "Manage..." for
    // bluetui. The panel powers the adapter on when it is off.
    "on-click": "~/scripts/bluetooth-panel.sh",
    // These lines control the hover state (tooltip)
    "tooltip-format": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)"
},
  "battery": {
    // omarchy's battery presentation: a 10-step ramp with a separate charging
    // ramp, icon-only in the bar, and the detail moved into the tooltip.
    // Omitted from omarchy's version: on-click "omarchy-menu power" and
    // on-click-right "omarchy-battery-status" -- neither command exists here.
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    // omarchy leaves this empty, which makes the module vanish whenever the
    // battery is plugged in but not charging -- exactly what a Framework
    // does once it hits its charge threshold ("Not charging" maps to the
    // plugged state). Show the level icon like every other state.
    "format-plugged": "{icon}",
    "format-full": "󰂅",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    // Click opens a stats panel (swaync notification with action buttons)
    // showing time remaining and the power-profile switcher, same set as
    // Super+Shift+B. Replaces the old format-alt click-to-toggle, which an
    // on-click would have shadowed regardless.
    "on-click": "~/scripts/battery-panel.sh",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5
  },
"network": {
    // Signal-strength ramp (empty outline -> filled cone), mapped across
    // signalStrength 0-100. Same Material Design glyphs omarchy uses.
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-wifi": "{icon}",
    // Signal strength only refreshes on poll, not on netlink events.
    "interval": 5,
    "format-ethernet": "󰈁",
    "format-disconnected": "OFFLINE",
    // Click opens a stats panel (swaync notification with action buttons);
    // the "Open Network Manager" button in it launches nmtui.
    "on-click": "~/scripts/wifi-panel.sh",
    "tooltip-format": "{ifname}",
    "tooltip-format-wifi": "<b>{essid}</b>\n{signalStrength}% ({signaldBm} dBm)  ·  {frequency} GHz\n↓ {bandwidthDownBits}   ↑ {bandwidthUpBits}"
},
  "custom/twitch_dl": {
    // Only visible while a VOD download is running (cron fires the downloader
    // at 18/20/22). Click for a panel with the streamer's profile picture,
    // VOD title, progress and a per-download cancel button.
    "format": "{}",
    "return-type": "json",
    "exec": "~/scripts/twitch-dl-panel.sh --waybar",
    "interval": 3,
    "hide-empty-text": true,
    "cursor": true,
    "on-click": "~/scripts/twitch-dl-panel.sh",
    "tooltip": true
  },
  "custom/display": {
    // Screen controls. Scroll the icon for brightness; click for the panel
    // (brightness steps, hyprsunset night light, kanshi layout reload).
    "format": "{}",
    "return-type": "json",
    "exec": "~/scripts/display-panel.sh --waybar",
    "interval": 5,
    "cursor": true,
    "on-click": "~/scripts/display-panel.sh",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip": true
  },
  "custom/handy": {
    "exec": "/home/knaught/scripts/handy-waybar.sh",
    "return-type": "json",
    "restart-interval": 1,
    "format": "{icon}",
    "format-icons": {
      "idle": "\uf130",
      "recording": "\uf111",
      "transcribing": "\uf110",
      "stopped": "\uf131"
    },
    "on-click": "handy --toggle-transcription",
    "tooltip": true
  },
  "custom/recording": {
    "format": "{}",
    "exec": "cat /tmp/recording.txt",
    "interval": 5,
    "hide-empty-text": true,
    "tooltip": true
  },
  "custom/blanket": {
    "format": "", // Or any icon you prefer
    "tooltip": true,
    "on-click": "blanket",
    "exec": "echo '{\"text\": \"Blanket\", \"tooltip\": \"Click to toggle controls\"}'",
    "return-type": "json"
  },
  "custom/protonvpn": {
    "format": "{}",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "exec": "~/scripts/protonvpn-waybar.sh",
    "on-click": "~/scripts/protonvpn-waybar.sh toggle",
    "tooltip": true
  },
  "custom/tailscale": {
    "format": "{}",
    "return-type": "json",
    "interval": 5,
    "exec": "~/scripts/tailscale-exit-node.sh",
    "on-click": "~/scripts/tailscale-exit-node.sh toggle",
    "tooltip": true
  },
  "custom/miniflux_download": {
    // Click opens the shared yt-dlp panel (both this and custom/yt-download
    // are yt-dlp), listing what is downloading with a cancel button each.
    "on-click": "~/scripts/yt-dl-panel.sh",
    "cursor": true,
    "format": "{}",
    "exec": "cat /tmp/miniflux_download_status.txt",
    "interval": 60,
    "hide-empty-text": true,
    "tooltip": true, // Explicitly enables tooltips
    "max-length": 30 // Optional: Keeps the bar tidy
  },
  "custom/twitch_vod_download": {
    "format": "{}",
    "exec": "cat /tmp/twitch_vod_status.txt",
    "interval": 5,
    "hide-empty-text": true,
    "tooltip": true
  },
  "custom/yt-download": {
    "on-click": "~/scripts/yt-dl-panel.sh",
    "cursor": true,
    "exec": "~/scripts/waybar-yt-download.sh",
    "return-type": "json",
    "interval": 60,
    "tooltip": false
  },
  "custom/rclone": {
    "format": "{}",
    "return-type": "json",
    "interval": 60,
    "exec": "~/.config/waybar/scripts/rclone_status.sh",
    "on-click": "notify-send 'Rclone Stats' \"$(rclone rc core/stats --rc-no-auth | jq -r '.transferring[] | .name' | head -n 5)\""
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "format-bluetooth-muted": "",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  }
}
