#!/usr/bin/env python3
"""Keep Newsboat postprocessing serialized and gentle on the desktop disk."""
import fcntl
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time


def byte_paced(command):
    """Pace local VOD writes; timestamp pacing is unreliable on fragmented VODs."""
    child=subprocess.Popen(command)
    started=time.monotonic()
    limit=32*1024*1024
    stopped=False
    def interrupted(signum, frame):
        raise InterruptedError('Postprocessing interrupted')
    signal.signal(signal.SIGTERM,interrupted)
    signal.signal(signal.SIGINT,interrupted)
    try:
        while child.poll() is None:
            try:
                counters=dict(line.split(':',1) for line in Path(f'/proc/{child.pid}/io').read_text().splitlines())
                ahead=int(counters['wchar'])/limit-(time.monotonic()-started)
            except (OSError,KeyError,ValueError):
                ahead=0
            if ahead>.1 and not stopped:
                os.kill(child.pid,signal.SIGSTOP);stopped=True
            elif ahead<=0 and stopped:
                os.kill(child.pid,signal.SIGCONT);stopped=False
            time.sleep(.05)
        return child.returncode
    finally:
        if child.poll() is None:
            child.kill()
            child.wait()


def paced_arguments(args):
    inputs=[args[i+1] for i,value in enumerate(args[:-1]) if value=='-i']
    if not inputs or not all(Path(value).is_file() for value in inputs):return args
    rate=0
    for value in inputs:
        try:
            result=subprocess.run(['/usr/bin/ffprobe','-v','error','-show_entries','format=duration',
                                   '-of','default=noprint_wrappers=1:nokey=1',value],
                                  capture_output=True,text=True,timeout=10,check=True)
            duration=float(result.stdout.strip())
            if duration<=0:return args
            rate+=Path(value).stat().st_size/duration
        except (OSError,ValueError,subprocess.SubprocessError):return args
    if rate<=0:return args
    # Read + write at about 32 MiB/s each, independent of the disk scheduler.
    speed=32*1024*1024/rate
    paced=[]
    for value in args:
        if value=='-i':paced.extend(['-readrate',f'{speed:.6f}'])
        paced.append(value)
    return paced


def main(args):
    if '-i' not in args:
        os.execv('/usr/bin/ffmpeg',['ffmpeg',*args])
    state=Path(os.environ.get('XDG_STATE_HOME',Path.home()/'.local/state'))/'newsboat/downloads'
    state.mkdir(parents=True,exist_ok=True)
    lock=(state/'.merge.lock').open('a')
    fcntl.flock(lock,fcntl.LOCK_EX)
    # Keep the lock owned by ffmpeg itself, including cancellation/shutdown.
    os.set_inheritable(lock.fileno(),True)
    try:os.setpriority(os.PRIO_PROCESS,0,max(15,os.getpriority(os.PRIO_PROCESS,0)))
    except OSError:pass
    byte_pacing=os.environ.get('NEWSBOAT_FFMPEG_BYTE_PACING')=='1'
    if not byte_pacing:args=paced_arguments(args)
    command=['/usr/bin/ffmpeg',*args]
    if ionice:=shutil.which('ionice'):command=[ionice,'-c','2','-n','7',*command]
    if byte_pacing:sys.exit(byte_paced(command))
    os.execv(command[0],command)


if __name__=='__main__':main(sys.argv[1:])
