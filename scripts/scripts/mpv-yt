#!/bin/bash
# Watch YouTube videos or Twitch videos that have been downloaded
# or stream YouTube videos or Twitch livestreams
# yt-dlp for VODS (YouTube & Twitch)
# streamlink for Twitch livestreams

VIDEO_DIR="$HOME/Videos/newsboat"

# Log everything to a file
echo "========== NEW RUN ==========" >>/tmp/mpv-yt-debug.log
echo "All args: $@" >>/tmp/mpv-yt-debug.log
echo "Arg 1: $1" >>/tmp/mpv-yt-debug.log
echo "Arg count: $#" >>/tmp/mpv-yt-debug.log
date >>/tmp/mpv-yt-debug.log

URL="$1"
# Everything after the URL is the article title, passed by the newsboat macro as
# %T. Taken as "the rest" rather than "$2": newsboat does not preserve the
# quoting around the substitution, so a six-word title arrives as six arguments.
TITLE="${*:2}"

# newsboat runs as `kitty -e newsboat`, which never sources a login shell, so
# its PATH is only /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin -- no
# ~/.local/bin. Without this, mpv picks up the pacman yt-dlp, which can only
# extract through a client YouTube refuses to serve to ffmpeg, and playback
# dies with HTTP 403.
YTDL="$HOME/.local/bin/yt-dlp"
[ -x "$YTDL" ] || YTDL=$(command -v yt-dlp 2>/dev/null)
export PATH="$HOME/.local/bin:$PATH"
YTDL_OPT="--script-opts=ytdl_hook-ytdl_path=$YTDL"

# Separate the YouTube app badge from the creator portrait.
YOUTUBE_ICON="/usr/share/icons/Papirus/48x48/apps/youtube.svg"
[ -f "$YOUTUBE_ICON" ] || YOUTUBE_ICON="youtube"

# A completion-checked lookup shared with deletion and the Downloaded library.
MEDIA_HELPER="$(dirname "$(readlink -f "$0")")/newsboat_media.py"
VIDEO_ID=$(python3 "$MEDIA_HELPER" identity "$URL" 2>/dev/null) || VIDEO_ID=""
DOWNLOADED=$(python3 "$MEDIA_HELPER" find "$URL" 2>/dev/null) || DOWNLOADED=""

export NEWSBOAT_MEDIA_URL="$URL"
export NEWSBOAT_MAINTENANCE="$(dirname "$(readlink -f "$0")")/newsboat-maintenance.py"
READY_OPTS=("--script=$(dirname "$(readlink -f "$0")")/newsboat-watch-completion.lua")
READY_OPTS+=("--script=$(dirname "$(readlink -f "$0")")/newsboat-local-playback.lua")
if [ -n "${NEWSBOAT_PLAY_READY:-}" ]; then
  READY_OPTS+=("--script=$(dirname "$(readlink -f "$0")")/newsboat-play-ready.lua")
fi

# The same creator portrait / app badge layout as YouTube, after playback starts.
if [[ "$URL" =~ ^https?://(www\.)?twitch\.tv/videos/[0-9]+ ]]; then
  export NEWSBOAT_TWITCH_URL="$URL"
  export NEWSBOAT_TWITCH_NOTIFY="$(dirname "$(readlink -f "$0")")/newsboat-twitch-notify.py"
  READY_OPTS+=("--script=$(dirname "$(readlink -f "$0")")/newsboat-twitch-notify.lua")
fi

# Only stop players, never downloads.
pkill -f "mpv.*ytdl-format" 2>/dev/null
pkill -f "streamlink.*--player" 2>/dev/null

if [ -n "$DOWNLOADED" ]; then
  META="$HOME/.cache/mpv-yt-videos/${VIDEO_ID}.meta"
  if [ -s "$META" ]; then
    # shellcheck disable=SC1090
    . "$META"
    cp -f "$META" /tmp/youtube-stream-context.conf 2>/dev/null
    NARGS=(-a "YouTube" --app-icon "$YOUTUBE_ICON" -t 5000 -u low)
    [ -n "${YT_ICON:-}" ] && [ -f "$YT_ICON" ] && NARGS+=(-h "string:image-path:$YT_ICON")
    notify-send "${NARGS[@]}" "${YT_TITLE:-Playing video}" "${YT_CHANNEL:-}" &
  fi
  mpv "${READY_OPTS[@]}" --save-position-on-quit --really-quiet "$DOWNLOADED" >/dev/null 2>&1 &
  exit 0
fi

# Check if it's a Twitch stream
if [[ "$URL" =~ twitch\.tv ]]; then
  # Read OAuth token from file
  TWITCH_TOKEN=$(cat ~/.newsboat/.twitch_oauth 2>/dev/null)

  # Check if it's a VOD (contains /videos/ in URL)
  if [[ "$URL" =~ /videos/ ]]; then
    exec mpv "${READY_OPTS[@]}" \
      "$YTDL_OPT" \
      --save-position-on-quit \
      --ytdl-format='bestvideo[height<=?1080][ext=mp4]+bestaudio[ext=m4a]/best[height<=?1080][ext=mp4]/best[height<=?1080]' \
      --cache=yes \
      --demuxer-lavf-o=live_start_index=0 \
      --cache-secs=0.5 \
      --demuxer-readahead-secs=0.5 \
      --demuxer-max-bytes=25M \
      --demuxer-max-back-bytes=10M \
      --force-window=immediate \
      --vo=gpu \
      --gpu-api=opengl \
      "$URL" >/dev/null 2>&1 &
    exit 0
  else
    notify-send "MPV" "Loading Twitch stream..." -t 3000 -u low &
    # Live stream - use low latency settings
    PLAYER_ARGS="--cache=yes --force-window=immediate --vo=gpu --gpu-api=opengl"
    PLAYER_ARGS+=" $(python3 -c 'import shlex, sys; print(shlex.join(sys.argv[1:]))' "${READY_OPTS[@]}")"
    STREAM_ARGS="--twitch-low-latency --stream-segment-threads 3 --stream-segment-attempts 3 --stream-segment-timeout 10 --retry-streams 2 --retry-open 2"
  fi

  if [ -n "$TWITCH_TOKEN" ]; then
    exec streamlink \
      --twitch-disable-ads \
      --twitch-api-header "Authorization=OAuth $TWITCH_TOKEN" \
      --player mpv \
      --player-args "$PLAYER_ARGS" \
      $STREAM_ARGS \
      "$URL" best >/dev/null 2>&1 &
  else
    # Fallback without token
    exec streamlink \
      --twitch-disable-ads \
      --player mpv \
      --player-args "$PLAYER_ARGS" \
      $STREAM_ARGS \
      "$URL" best >/dev/null 2>&1 &
  fi
else
  # YouTube and other videos.
  #
  # One notification, once the video is actually playing.
  #
  # The title, uploader and channel url all come from mpv itself over IPC. They
  # used to come from a second yt-dlp extraction, which meant running the same
  # ~1.8s network extraction TWICE per keypress -- once for mpv to play the
  # video and once more only to name it -- with the two competing for the
  # connection. mpv already has this metadata the moment playback starts.
  NOTIFY_ID=$(($(printf '%s' "$URL" | cksum | cut -d' ' -f1) % 2147483647))
  (
    sock="/tmp/mpv-yt-ipc"
    chan=""
    curl_url=""
    for _ in $(seq 1 80); do
      md=$(printf '%s\n' '{"command":["get_property","metadata"]}' |
        timeout 2 socat - "$sock" 2>/dev/null)
      chan=$(jq -r '.data.uploader // empty' <<<"$md" 2>/dev/null)
      curl_url=$(jq -r '.data.channel_url // empty' <<<"$md" 2>/dev/null)
      [ -n "$chan" ] && break
      sleep 0.25
    done
    # youtube pads some uploader names with trailing spaces
    chan=$(printf '%s' "$chan" | sed 's/[[:space:]]*$//')
    if [ -z "$TITLE" ]; then
      TITLE=$(printf '%s\n' '{"command":["get_property","media-title"]}' |
        timeout 2 socat - "$sock" 2>/dev/null | jq -r '.data // empty')
    fi
    cid="${curl_url##*/}"
    icon=""
    [ -n "$cid" ] && icon=$("$HOME/scripts/yt-channel-pic.sh" "$cid" 2>/dev/null)
    args=(-a "YouTube" --app-icon "$YOUTUBE_ICON" -r "$NOTIFY_ID" -t 5000 -u low)
    [ -n "$icon" ] && args+=(-h "string:image-path:$icon")
    [ -n "${TITLE:-}" ] && notify-send "${args[@]}" "$TITLE" "${chan:-YouTube}"

    # Record what is playing so twitch-cycle-quality.sh can name the video and
    # show the channel avatar without any lookup of its own. Quotes in a title
    # would break the sourced file, so they are folded to apostrophes.
    {
      printf 'YT_URL="%s"\n' "$URL"
      printf 'YT_TITLE="%s"\n' "$(printf '%s' "$TITLE" | tr '"' "'")"
      printf 'YT_CHANNEL="%s"\n' "$(printf '%s' "$chan" | tr '"' "'")"
      printf 'YT_ICON="%s"\n' "$icon"
    } >/tmp/youtube-stream-context.conf 2>/dev/null

    # --- swap onto a local copy -------------------------------------------
    # YouTube throttles a plain sequential read to roughly playback rate
    # (measured ~160 KB/s), which is why seeking cost 6-7s: every seek outside
    # the ~16s buffer had to fetch the gap at that rate, and no mpv setting
    # changes it -- codec, hwdec, hr-seek, readahead, buffer size and DASH
    # manifests were all measured and none helped.
    #
    # yt-dlp's downloader is NOT throttled, because it fetches bounded ranges
    # rather than one open-ended read: 54-97 MB/s measured, a 26-minute 1080p
    # video complete in 6.1s. So the file is fetched in the background and mpv
    # is moved onto it, keeping its position. Streaming still starts playback
    # immediately, so this costs nothing up front and seeking becomes local.
    dur=$(printf '%s\n' '{"command":["get_property","duration"]}' |
      timeout 2 socat - "$sock" 2>/dev/null | jq -r '.data // 0')
    vid=$(printf '%s' "$URL" | grep -oP '(?:v=|youtu\.be/)\K[A-Za-z0-9_-]{11}' | head -1)
    # A live stream has no duration and would never finish downloading.
    if [ -n "$vid" ] && awk -v d="$dur" 'BEGIN{exit !(d>0)}'; then
      cache="$HOME/.cache/mpv-yt-videos"
      mkdir -p "$cache"
      local_file="$cache/$vid.mp4"
      if ! python3 "$MEDIA_HELPER" find "$URL" >/dev/null 2>&1; then
        "$YTDL" -q --no-warnings \
          -f "bestvideo[height<=?1080]+bestaudio/best[height<=?1080]/best" \
          --merge-output-format mp4 --max-filesize 3G \
          -o "$cache/$vid.%(ext)s" "$URL" >/dev/null 2>&1
      fi
      # Only swap if it actually landed AND mpv is still up: closing the window
      # mid-download must not resurrect it.
      # Sidecar so a replay from cache can show the same notification and feed
      # the quality key: a merged mp4 carries no uploader or channel id.
      local_file=$(python3 "$MEDIA_HELPER" find "$URL" 2>/dev/null) || local_file=""
      if [ "$local_file" = "$cache/$vid.mp4" ]; then
        {
          printf 'YT_URL="%s"\n' "$URL"
          printf 'YT_TITLE="%s"\n' "$(printf '%s' "$TITLE" | tr '"' "'")"
          printf 'YT_CHANNEL="%s"\n' "$(printf '%s' "$chan" | tr '"' "'")"
          printf 'YT_ICON="%s"\n' "$icon"
        } >"$cache/$vid.meta" 2>/dev/null
      fi
      if [ -n "$local_file" ] &&
        printf '%s\n' '{"command":["get_property","time-pos"]}' |
        timeout 2 socat - "$sock" 2>/dev/null | grep -q '"error":"success"'; then
        pos=$(printf '%s\n' '{"command":["get_property","time-pos"]}' |
          timeout 2 socat - "$sock" 2>/dev/null | jq -r '.data // 0')
        jq -cn --arg f "$local_file" --arg s "$pos" --arg u "$URL" \
          --arg t "$TITLE" --arg i "$icon" --arg b "$YOUTUBE_ICON" \
          '{"command":["script-message-to","newsboat_local_playback","switch",$u,$f,$s,$t,$i,$b]}' |
          timeout 5 socat - "$sock" >/dev/null 2>&1
      fi
      # Keep the cache under 6GB, oldest first.
      total=$(du -sm "$cache" 2>/dev/null | cut -f1)
      while [ "${total:-0}" -gt 6144 ]; do
        oldest=$(find "$cache" -maxdepth 1 -type f -printf '%T@ %p\n' 2>/dev/null |
          sort -n | head -1 | cut -d' ' -f2-)
        [ -n "$oldest" ] || break
        rm -f "$oldest"
        total=$(du -sm "$cache" 2>/dev/null | cut -f1)
      done
    fi
  ) >/dev/null 2>&1 &
  # Optimization:
  # 1. We remove the 0.5s readahead (let it buffer 10-30s for smooth seeking).
  # 2. We use --ytdl-raw-options to favor fast-starting streams.
  exec mpv "${READY_OPTS[@]}" \
    "$YTDL_OPT" \
    --save-position-on-quit \
    --ytdl-format="bestvideo[height<=?1080]+bestaudio/best[height<=?1080]/best" \
    --cache=yes \
    --demuxer-max-bytes=128M \
    --demuxer-readahead-secs=20 \
    --force-window=immediate \
    --hwdec=auto \
    --vo=gpu \
    --gpu-api=opengl \
    "$URL" >/dev/null 2>&1 &
fi
